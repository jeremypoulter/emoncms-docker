# Default docker enviroment variables, change in production enviroment

# General
TZ=Europe/London
EMONCMS_DATADIR=/var/opt/emoncms
EMONCMS_LOG_LEVEL=2

# MySQL database
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=emoncms
MYSQL_USER=emoncms
MYSQL_PASSWORD=YOUR_SECURE_PASSWORD
MYSQL_RANDOM_ROOT_PASSWORD=yes
MYSQL_INITDB_SKIP_TZINFO=true

# Redis
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PREFIX='emoncms'
REDIS_BUFFER=1

# MQTT
MQTT_ENABLED=true
MQTT_HOST=mqtt
MQTT_CLIENTID=emoncmsmqtt
MQTT_USER=emonpi
MQTT_PASSWORD=emonpimqtt2016
MQTT_BASETOPIC=emon
MQTT_PORT=1883

# Feed
PHPFINA_DIR=/var/opt/emoncms/phpfina/
PHPTIMESERIES_DIR=/var/opt/emoncms/phptimeseries/
