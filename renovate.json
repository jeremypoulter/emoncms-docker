{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "labels": [
    "area:deps"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Components pinned in web/components.lock: bump the commit along the tracked ref",
      "fileMatch": [
        "^web/components\\.lock$"
      ],
      "matchStrings": [
        "^(?<depName>\\S+)\\s+\\S+\\s+(?<packageName>https://\\S+)\\s+(?<currentValue>\\S+)\\s+(?<currentDigest>[0-9a-f]{40})\\s*$"
      ],
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    }
  ],
  "packageRules": [
    {
      "description": "Never automerge component bumps; the smoke and upgrade tests gate them",
      "matchDatasources": [
        "git-refs"
      ],
      "automerge": false
    },
    {
      "description": "EmonScripts stays at 1.9.8 until EmonOS N70",
      "matchDepNames": [
        "EmonScripts"
      ],
      "enabled": false
    },
    {
      "description": "PHP base image digest bumps (same tag, new digest) automerge once the PR build and scan are green",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    }
  ]
}
